# Copy to .env.local for local development (never commit real values).
# In Vercel, set these under Project → Settings → Environment Variables
# for both Production and Preview.

# Cloudflare Turnstile (contact form bot protection)
# Site key is public; the secret key must only ever be set on the server.
# In local development (npm run dev), Cloudflare's test keys are used automatically if these are empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (email delivery for contact form submissions) — see TODO(email) in app/api/contact/route.ts
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Public site URL override (defaults to https://www.unityrenovations.ca; leave empty unless you need a different host)
NEXT_PUBLIC_SITE_URL=
